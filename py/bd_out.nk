set cut_paste_input [stack 0]
version 15.1 v6
BackdropNode {
 inputs 0
 name Backdrop_preRender
 tile_color 0x9f9000ff
 label Pre-
 note_font_size 50
 selected true
 xpos 100
 ypos 100
 bdwidth 387
 bdheight 342
 z_order 6
 addUserKnob {20 backdrop}
 addUserKnob {41 label_link l Label T label}
 addUserKnob {7 lga_note_font_size l "Font Size" R 10 100}
 lga_note_font_size 50
 addUserKnob {4 lga_margin l "" -STARTLINE M {left center right}}
 addUserKnob {26 font_label l "" +STARTLINE T "       Font "}
 addUserKnob {41 note_font_link l "" -STARTLINE T note_font}
 addUserKnob {26 divider_2 l "" +STARTLINE}
 addUserKnob {26 resize_label l "" -STARTLINE T "    Resize  "}
 addUserKnob {26 margin_label l "" -STARTLINE T "Margin "}
 addUserKnob {7 margin_slider l "" t "Margin slider for auto fit" -STARTLINE R 10 200}
 margin_slider 50
 addUserKnob {52 lga_autofit_control l "" -STARTLINE T nuke.LGA_AutoFitControlWidget(nuke.thisNode())}
 addUserKnob {26 divider_style l "" +STARTLINE}
 addUserKnob {26 appearance_label l "" +STARTLINE T "      Style "}
 addUserKnob {41 appearance_link l "" -STARTLINE T appearance}
 addUserKnob {41 border_width_link l "" -STARTLINE T border_width}
 addUserKnob {52 lga_save_defaults l "" -STARTLINE T nuke.LGA_SaveDefaultsWidget(nuke.thisNode())}
 addUserKnob {26 divider_3 l "" +STARTLINE}
 addUserKnob {26 z_order_label l "" -STARTLINE T "   Z Order  "}
 addUserKnob {26 zorder_back l "" -STARTLINE T "Back "}
 addUserKnob {7 zorder l "" -STARTLINE R -10 10}
 zorder 6
 addUserKnob {26 zorder_front l "" -STARTLINE T " Front"}
 addUserKnob {26 zorder_space l "" -STARTLINE T " "}
 addUserKnob {26 divider_4 l "" +STARTLINE}
 addUserKnob {52 lga_color_palette l "" -STARTLINE T nuke.LGA_ColorSwatchWidget(nuke.thisNode())}
}
